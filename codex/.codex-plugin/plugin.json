{
  "name": "peermesh",
  "version": "0.5.5",
  "description": "Messages between the Claude Code and Codex sessions on this machine: the peermesh hooks, MCP tools and skill",
  "author": {
    "name": "Koiiichi",
    "url": "https://github.com/Koiiichi"
  },
  "repository": "https://github.com/Koiiichi/peermesh",
  "license": "Apache-2.0",
  "mcpServers": "./.mcp.json",
  "hooks": {
    "hooks": {
      "SessionStart": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "\"$PLUGIN_ROOT/bin/peers\" hook session-start --runtime codex --inbox --plugin # peermesh",
              "timeout": 10
            }
          ]
        }
      ],
      "UserPromptSubmit": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "\"$PLUGIN_ROOT/bin/peers\" hook prompt --runtime codex --inbox --plugin # peermesh",
              "timeout": 10
            }
          ]
        }
      ],
      "Stop": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "\"$PLUGIN_ROOT/bin/peers\" hook stop --runtime codex --plugin # peermesh",
              "timeout": 45
            }
          ]
        }
      ],
      "SessionEnd": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "\"$PLUGIN_ROOT/bin/peers\" hook session-end --runtime codex --plugin # peermesh",
              "timeout": 3
            }
          ]
        }
      ],
      "PostToolUse": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "/bin/sh -c 'p=$(cat); id=$(printf \"%s\" \"$p\" | grep -o \"\\\"session_id\\\": *\\\"[^\\\"]*\\\"\" | head -n 1 | sed \"s/.*\\\"\\([^\\\"]*\\)\\\"$/\\1/\"); box=\"${PEERMESH_HOME:-$HOME/.peermesh}/inbox/${2}_${id}\"; if [ -n \"$id\" ] && [ -z \"$(ls -A \"$box\" 2>/dev/null)\" ]; then exit 0; fi; printf \"%s\" \"$p\" | exec \"$1\" hook post-tool --runtime \"$2\" --plugin' peermesh \"$PLUGIN_ROOT/bin/peers\" codex # peermesh",
              "timeout": 10
            }
          ]
        }
      ]
    }
  },
  "interface": {
    "displayName": "peermesh",
    "shortDescription": "Send and receive messages between agent sessions on this machine",
    "developerName": "Koiiichi",
    "category": "Developer Tools",
    "capabilities": [
      "Interactive"
    ]
  }
}
